<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Used by the config UI only. The hook runs inside SystemUI, which already
         holds INTERNET and MEDIA_CONTENT_CONTROL. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Needed to enumerate/query the target music apps on Android 11+. -->
    <queries>
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="app.revanced.android.apps.youtube.music" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LyricProvider">

        <!-- ===== LSPosed / Xposed module declaration ===== -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Shows synced lyrics in the status bar. Reads the track from YT Music/Spotify and fetches lyrics from your private API. Scope: System UI." />
        <!-- 93 = minimum for modern LSPosed. -->
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposedscope" />
        <!-- Lets the hook read this app's settings from inside SystemUI
             (LSPosed makes the preference file world-readable). -->
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
